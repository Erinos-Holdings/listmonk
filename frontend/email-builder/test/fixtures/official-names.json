{
 "comment": "The official-template name grammar, resolution and the neutral-footer text rule (integrations listmonk/BRAND-FOOTER-SPEC D1-D3, D5). ONE case table read by the builder's test/official-resolve.test.cjs (official/resolve.ts), the Vue frontend/src/officialSweep.test.mjs (officialSweep.mjs), Go models/official_names_test.go (models.ParseOfficialName, models.OfficialNeutralHasText) and integrations tests/lib/official-footer.test.ts (lib/official-footer-repair.ts, lib/official-footer-seed.ts) -- change every implementation together. parse: name -> {kind, brand (the slug), lang ('' = language-neutral)} or null. resolve: refs [[id, name]] + context + kind -> {status, name, id (null = no ref)}. neutralText: a builder document -> whether a language-neutral brand footer holding it would carry text (refused).",
 "parse": [
  { "name": "Official Footer EN", "want": { "kind": "corporate", "brand": "", "lang": "EN" } },
  { "name": "Official Footer IT", "want": { "kind": "corporate", "brand": "", "lang": "IT" } },
  { "name": "Official RUZE Footer", "want": { "kind": "brand", "brand": "ruze", "lang": "" } },
  { "name": "Official ThirstyGirl Footer", "want": { "kind": "brand", "brand": "thirstygirl", "lang": "" } },
  { "name": "Official Thirsty Girl Footer", "want": { "kind": "brand", "brand": "thirstygirl", "lang": "" } },
  { "name": "Official Shala Footer FR", "want": { "kind": "brand", "brand": "shala", "lang": "FR" } },
  { "name": "Official younique Footer", "want": { "kind": "brand", "brand": "younique", "lang": "" } },
  { "name": "Official KNOWN FOR FRAGRANCE Footer", "want": { "kind": "brand", "brand": "knownforfragrance", "lang": "" } },
  { "name": "Official Footer Footer EN", "want": { "kind": "brand", "brand": "footer", "lang": "EN" } },
  { "name": "Official Footer Footer", "want": { "kind": "brand", "brand": "footer", "lang": "" } },
  { "name": "Official EN Footer", "want": { "kind": "brand", "brand": "en", "lang": "" } },
  { "name": "Official LIYORÁ Footer", "want": { "kind": "brand", "brand": "liyor", "lang": "" } },
  { "name": "Official_Footer_EN", "want": null },
  { "name": "Official_RUZE_Footer_EN", "want": null },
  { "name": "Official Footer", "want": null },
  { "name": "Official Footer en", "want": null },
  { "name": "Official Footer ENG", "want": null },
  { "name": "Official RUZE Footer E", "want": null },
  { "name": "Official RUZE Footer es", "want": null },
  { "name": "Official RUZE Footer EN ", "want": null },
  { "name": "Official  RUZE Footer", "want": null },
  { "name": "Official RUZE  Footer", "want": null },
  { "name": "Official --- Footer", "want": null },
  { "name": "Official RUZE Header", "want": null },
  { "name": "official Footer EN", "want": null },
  { "name": "Copy of Official Footer EN", "want": null },
  { "name": "Official", "want": null },
  { "name": "", "want": null }
 ],
 "resolve": [
  { "case": "corporate en", "kind": "corporate", "context": { "lang": "en", "brand": "ruze" }, "refs": [[30, "Official Footer EN"], [31, "Official Footer ES"], [14, "Official RUZE Footer"]], "want": { "status": "ok", "name": "Official Footer EN", "id": 30 } },
  { "case": "empty lang resolves as en", "kind": "corporate", "context": { "lang": "", "brand": null }, "refs": [[30, "Official Footer EN"], [31, "Official Footer ES"]], "want": { "status": "ok", "name": "Official Footer EN", "id": 30 } },
  { "case": "corporate es, brand unknown", "kind": "corporate", "context": { "lang": "es", "brand": null }, "refs": [[30, "Official Footer EN"], [31, "Official Footer ES"]], "want": { "status": "ok", "name": "Official Footer ES", "id": 31 } },
  { "case": "corporate de absent -> missing, no fallback", "kind": "corporate", "context": { "lang": "de", "brand": "ruze" }, "refs": [[30, "Official Footer EN"], [31, "Official Footer ES"]], "want": { "status": "missing", "name": "Official Footer DE", "id": null } },
  { "case": "corporate never resolves a neutral brand name", "kind": "corporate", "context": { "lang": "en", "brand": "ruze" }, "refs": [[14, "Official RUZE Footer"], [99, "Official Footer Footer"]], "want": { "status": "missing", "name": "Official Footer EN", "id": null } },
  { "case": "brand neutral en", "kind": "brand", "context": { "lang": "en", "brand": "ruze" }, "refs": [[30, "Official Footer EN"], [14, "Official RUZE Footer"]], "want": { "status": "ok", "name": "Official RUZE Footer", "id": 14 } },
  { "case": "brand neutral serves every language (fr, RUZE slug-compared)", "kind": "brand", "context": { "lang": "fr", "brand": "RUZE" }, "refs": [[30, "Official Footer EN"], [14, "Official RUZE Footer"]], "want": { "status": "ok", "name": "Official RUZE Footer", "id": 14 } },
  { "case": "override wins over neutral", "kind": "brand", "context": { "lang": "fr", "brand": "ruze" }, "refs": [[14, "Official RUZE Footer"], [60, "Official RUZE Footer FR"]], "want": { "status": "ok", "name": "Official RUZE Footer FR", "id": 60 } },
  { "case": "no override for es -> neutral", "kind": "brand", "context": { "lang": "es", "brand": "ruze" }, "refs": [[14, "Official RUZE Footer"], [60, "Official RUZE Footer FR"]], "want": { "status": "ok", "name": "Official RUZE Footer", "id": 14 } },
  { "case": "override only, its language", "kind": "brand", "context": { "lang": "es", "brand": "shala" }, "refs": [[35, "Official Shala Footer EN"], [52, "Official Shala Footer ES"]], "want": { "status": "ok", "name": "Official Shala Footer ES", "id": 52 } },
  { "case": "override only, another language -> missing", "kind": "brand", "context": { "lang": "fr", "brand": "shala" }, "refs": [[35, "Official Shala Footer EN"], [52, "Official Shala Footer ES"]], "want": { "status": "missing", "name": "Official shala Footer", "id": null } },
  { "case": "brand with no template -> missing", "kind": "brand", "context": { "lang": "en", "brand": "liyora" }, "refs": [[14, "Official RUZE Footer"]], "want": { "status": "missing", "name": "Official liyora Footer", "id": null } },
  { "case": "curated is an ordinary brand", "kind": "brand", "context": { "lang": "it", "brand": "curated" }, "refs": [[37, "Official Curated Footer"]], "want": { "status": "ok", "name": "Official Curated Footer", "id": 37 } },
  { "case": "two spellings of one slug -> lowest id + duplicate", "kind": "brand", "context": { "lang": "en", "brand": "thirstygirl" }, "refs": [[70, "Official Thirsty Girl Footer"], [24, "Official ThirstyGirl Footer"]], "want": { "status": "duplicate", "name": "Official ThirstyGirl Footer", "id": 24 } },
  { "case": "duplicate override -> lowest id + duplicate", "kind": "brand", "context": { "lang": "fr", "brand": "ruze" }, "refs": [[14, "Official RUZE Footer"], [61, "Official RUZE Footer FR"], [60, "Official RUZE Footer FR"]], "want": { "status": "duplicate", "name": "Official RUZE Footer FR", "id": 60 } },
  { "case": "duplicate corporate -> lowest id + duplicate", "kind": "corporate", "context": { "lang": "en" }, "refs": [[40, "Official Footer EN"], [30, "Official Footer EN"]], "want": { "status": "duplicate", "name": "Official Footer EN", "id": 30 } },
  { "case": "the old prefix is not official (corporate)", "kind": "corporate", "context": { "lang": "en", "brand": "ruze" }, "refs": [[5, "Official_Footer_EN"]], "want": { "status": "missing", "name": "Official Footer EN", "id": null } },
  { "case": "the old prefix is not official (brand)", "kind": "brand", "context": { "lang": "en", "brand": "ruze" }, "refs": [[6, "Official_RUZE_Footer_EN"]], "want": { "status": "missing", "name": "Official ruze Footer", "id": null } },
  { "case": "only the exact name resolves", "kind": "corporate", "context": { "lang": "en" }, "refs": [[5, "Copy of Official Footer EN"]], "want": { "status": "missing", "name": "Official Footer EN", "id": null } },
  { "case": "brand unknown -> no-context", "kind": "brand", "context": { "lang": "en", "brand": null }, "refs": [[14, "Official RUZE Footer"]], "want": { "status": "no-context", "name": "", "id": null } },
  { "case": "brand empty -> no-context", "kind": "brand", "context": { "lang": "en", "brand": " " }, "refs": [[14, "Official RUZE Footer"]], "want": { "status": "no-context", "name": "", "id": null } },
  { "case": "no context (brand)", "kind": "brand", "context": null, "refs": [[14, "Official RUZE Footer"]], "want": { "status": "no-context", "name": "", "id": null } },
  { "case": "no context (corporate)", "kind": "corporate", "context": null, "refs": [[30, "Official Footer EN"]], "want": { "status": "no-context", "name": "", "id": null } }
 ],
 "neutralText": [
  { "case": "logo Image + icons-only Html", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["c"] } }, "c": { "type": "Container", "data": { "props": { "childrenIds": ["i", "h"] } } }, "i": { "type": "Image", "data": { "props": { "url": "https://x.invalid/logo.png", "alt": "LIYORÁ" } } }, "h": { "type": "Html", "data": { "props": { "contents": "<table role=\"presentation\"><tr><td><a href=\"https://facebook.com/x\" aria-label=\"Facebook\"><img src=\"https://x.invalid/fb.png\" alt=\"Facebook\"></a></td></tr></table>" } } } } },
  { "case": "a Text block", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["t"] } }, "t": { "type": "Text", "data": { "props": { "text": "Follow us" } } } } },
  { "case": "an empty Text block is still a Text block", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["t"] } }, "t": { "type": "Text", "data": { "props": { "text": "" } } } } },
  { "case": "a Heading block", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["t"] } }, "t": { "type": "Heading", "data": { "props": { "text": "RUZE" } } } } },
  { "case": "a Button block", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["b"] } }, "b": { "type": "Button", "data": { "props": { "text": "Shop", "url": "https://x.invalid" } } } } },
  { "case": "Html with visible text", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<p style=\"color:#000\">Follow <b>us</b></p>" } } } } },
  { "case": "Html whose only text is a whitespace entity", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<td>&nbsp;</td><td>&#160; &#xA0;</td>" } } } } },
  { "case": "Html whose only text is a visible entity", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<td>&copy;</td>" } } } } },
  { "case": "Html with text inside an mso conditional (Outlook shows it)", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<!--[if mso]><table><tr><td>Follow us</td></tr></table><![endif]-->" } } } } },
  { "case": "Html with markup-only mso conditional", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<!--[if mso]><table role=\"presentation\"><tr><td><![endif]--><img src=\"https://x.invalid/fb.png\" alt=\"Facebook\"><!--[if mso]></td></tr></table><![endif]-->" } } } } },
  { "case": "Html with a plain comment only", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<!-- social row --><img src=\"https://x.invalid/fb.png\" alt=\"Facebook\">" } } } } },
  { "case": "Html with style content only", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<style>.x td { padding: 0 6px; }</style><img src=\"https://x.invalid/fb.png\" alt=\"Facebook\">" } } } } },
  { "case": "Html with a template action only", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<a href=\"{{ UnsubscribeURL }}\"><img src=\"https://x.invalid/u.png\" alt=\"x\"></a>{{ Date \"2006\" }}" } } } } },
  { "case": "Html with text beside an action", "text": true, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": ["h"] } }, "h": { "type": "Html", "data": { "props": { "contents": "<p>© {{ Date \"2006\" }}</p>" } } } } },
  { "case": "an empty document", "text": false, "source": { "root": { "type": "EmailLayout", "data": { "childrenIds": [] } } } }
 ]
}
